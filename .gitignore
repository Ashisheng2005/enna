# ══════════════════════════════════════════════════════════════
#  Enna · .gitignore
#
#  ⚠️ 本仓库描述的系统会持有 SSH 凭据与审计日志。
#     敏感文件必须在第一次提交前就被排除，事后清理历史很痛苦。
# ══════════════════════════════════════════════════════════════

# ── 构建产物 ──
/enna
/enna-*.exe
/dist/
*.test
*.out
coverage.*

# ── Go ──
vendor/

# ── Python（M2 起：enna-brain）──
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ──────────────────────────────────────────────────────────────
#  ⚠️ 以下为敏感内容，绝不入库
#
#  ⚠️⚠️ 锚定规则：凡是指"仓库根下的运行时数据目录"的规则，
#      必须用前导斜杠锚定，如 /audit/ 而不是 audit/。
#
#      原因（真实踩过的坑）：不带前导斜杠且带尾随斜杠的模式会匹配
#      **任意层级**的同名目录。曾用 `audit/` 导致源码包
#      `internal/audit/` 被整体静默排除 —— 本地因为文件还在磁盘上
#      所以照常编译，但新克隆的仓库会直接编译失败。
#
#      自检命令（应无输出）：
#        comm -23 <(find . -name '*.go' -not -path './.git/*' | sort) \
#                 <(git ls-files '*.go' | sort)
# ──────────────────────────────────────────────────────────────

# 真实配置：含设备地址、账号、凭据引用、主体 QQ 号
# 仓库只提交 *.example.yaml 模板；运行时复制为 *.yaml
configs/*.yaml
!configs/*.example.yaml
configs/local/
*.local.yaml

# 凭据与密钥（FR-AU-05 / FR-AU-06）
# 注意：*.key / *.pem 等后缀规则刻意保留"任意层级"语义 ——
# 宁可连测试夹具里的假密钥一起挡住，也不要漏掉一个真密钥。
*.key
*.pem
*.p12
*.age
/secrets/
/vault/

# SSH 主机指纹（防中间人的信任锚，属环境状态而非代码）
/known_hosts

# 审计与运行数据（FR-AU-01 / FR-AU-07）
# ⚠️ 必须锚定：内部源码包同样叫 audit（internal/audit）
/audit/
/artifacts/
/data/

# 环境变量与令牌
.env
.env.*

# ── 本地端到端验证的临时目录 ──
.e2e/

# ── 编辑器 / 系统 ──
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
